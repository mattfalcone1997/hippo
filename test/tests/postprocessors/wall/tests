[Tests]
  [setup]
    type = RunCommand
    command = 'bash prep.sh'
  []
  [serial]
    type = RunApp
    input = main.i
    prereq = setup
    max_parallel = 1
  []
  [verify_serial]
    type = PythonUnitTest
    input = test.py
    prereq = serial
  []
  [parallel]
    type = RunApp
    input = main.i
    prereq = verify_serial
    min_parallel = 2
    max_parallel = 2
  []
  [verify_parallel]
    type = PythonUnitTest
    input = test.py
    prereq = parallel
  []
  [bulk_temperature_count]
    type = RunException
    input = main.i
    cli_args = "Postprocessors/htc_opposite/bulk_temperature_uo=cold_left"
    expect_err = 'Exactly one bulk temperature user object must be provided per boundary'
    prereq = verify_parallel
    max_parallel = 1
  []
  [empty_boundaries]
    type = RunException
    input = main.i
    cli_args = "Postprocessors/temperature_right/boundary=''"
    expect_err = "At least one boundary must be specified"
    prereq = verify_parallel
    max_parallel = 1
  []
  [duplicate_boundaries]
    type = RunException
    input = main.i
    cli_args = "Postprocessors/integral_combined/boundary='right top right'"
    expect_err = "Boundary 'right' is listed more than once"
    prereq = verify_parallel
    max_parallel = 1
  []
  [unknown_boundary]
    type = RunException
    input = main.i
    cli_args = "Postprocessors/flux_right/boundary='missing_wall'"
    expect_err = "Boundary 'missing_wall' not found"
    prereq = verify_parallel
    max_parallel = 1
  []
  [side_duplicate_boundaries]
    type = RunException
    input = main.i
    cli_args = "Postprocessors/side_temperature/boundary='right top right'"
    expect_err = "Boundary 'right' is listed more than once"
    prereq = verify_parallel
    max_parallel = 1
  []
[]
